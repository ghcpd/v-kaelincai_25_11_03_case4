{
  "scenario": "Transaction summarisation refactor benchmark focusing on deduplication, defensive parsing, and deterministic aggregation.",
  "input_format": "Iterable of transaction mappings with keys id, amount, category, optional currency/status.",
  "cases": [
    {
      "name": "basic_valid",
      "description": "Happy path with mixed currencies and categories.",
      "input": {
        "transactions": [
          {"id": "t1", "amount": 120.5, "category": "Groceries", "currency": "usd"},
          {"id": "t2", "amount": 75.0, "category": "Utilities", "currency": "USD"},
          {"id": "t3", "amount": 220.0, "category": "Rent", "currency": "USD"},
          {"id": "t4", "amount": 15.25, "category": "Groceries", "currency": "EUR", "status": "pending"}
        ]
      },
      "expected": {
        "total_amount": 430.75,
        "transaction_count": 4,
        "category_totals": {"groceries": 135.75, "rent": 220.0, "utilities": 75.0},
        "currency_totals": {"EUR": 15.25, "USD": 415.5},
        "invalid_entries": [],
        "high_value_ids": []
      }
    },
    {
      "name": "with_duplicates_and_invalid",
      "description": "Deduplicates on id, records invalid amounts, and identifies high value ids.",
      "input": {
        "transactions": [
          {"id": "d1", "amount": "50", "category": "Travel", "currency": "usd"},
          {"id": "d1", "amount": 60.0, "category": "Travel", "currency": "usd"},
          {"id": "d2", "amount": "85.5", "category": "Travel", "currency": "usd"},
          {"id": "d3", "amount": "", "category": "Entertainment", "currency": "USD"},
          {"id": "d4", "amount": null, "category": "Misc"},
          {"id": "d5", "amount": 1200.0, "category": "Supplies", "currency": "usd"},
          {"id": null, "amount": 10.0, "category": "", "currency": ""},
          {"amount": 30.0, "category": "Travel", "currency": "usd"}
        ]
      },
      "expected": {
        "total_amount": 1385.5,
        "transaction_count": 5,
        "category_totals": {"travel": 175.5, "supplies": 1200.0, "uncategorized": 10.0},
        "currency_totals": {"USD": 1385.5},
        "invalid_entries": [
          {"index": 3, "id": "d3", "error": "empty_amount"},
          {"index": 4, "id": "d4", "error": "non_numeric_amount"}
        ],
        "high_value_ids": ["d5"]
      }
    },
    {
      "name": "iterator_with_non_mapping",
      "description": "Ensures non-mapping entries are rejected and whitespace amounts are caught.",
      "input": {
        "transactions": [
          {"id": "m1", "amount": 0, "category": "Misc", "currency": "USD"},
          ["unexpected", "structure"],
          {"id": "m2", "amount": "15.75", "category": "Misc", "currency": "USD"},
          {"id": "m3", "amount": "  ", "category": "Misc"},
          {"id": "m2", "amount": 18.25, "category": "Misc"}
        ]
      },
      "expected": {
        "total_amount": 18.25,
        "transaction_count": 2,
        "category_totals": {"misc": 18.25},
        "currency_totals": {"USD": 18.25},
        "invalid_entries": [
          {"index": 1, "id": null, "error": "not_mapping"},
          {"index": 3, "id": "m3", "error": "empty_amount"}
        ],
        "high_value_ids": []
      }
    },
    {
      "name": "large_batch_generated",
      "description": "Synthetic 1000 record feed for performance measurement.",
      "input": {
        "generated": {
          "count": 1000,
          "id_prefix": "bulk",
          "categories": ["utilities", "travel", "rent", "groceries"],
          "currencies": ["USD", "EUR"],
          "amount_modulus": 7,
          "amount_offset": 1,
          "amount_factor": 3.5,
          "amount_base": 2
        }
      },
      "expected": {
        "total_amount": 15989.5,
        "transaction_count": 1000,
        "category_totals": {
          "utilities": 3989.5,
          "travel": 4007.0,
          "rent": 4000.0,
          "groceries": 3993.0
        },
        "currency_totals": {"USD": 7989.5, "EUR": 8000.0},
        "invalid_entries": [],
        "high_value_ids": []
      }
    },
    {
      "name": "invalid_input_type",
      "description": "Non-iterable input should raise ValueError.",
      "input": {
        "raw": 42
      },
      "expected": {
        "total_amount": 0,
        "transaction_count": 0,
        "category_totals": {},
        "currency_totals": {},
        "invalid_entries": [],
        "high_value_ids": []
      },
      "expect_exception": "ValueError"
    }
  ]
}
